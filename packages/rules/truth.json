{
  "family": "truth",
  "title": "Truthfulness",
  "rules": [
    {
      "id": "truth.unverified-claim",
      "severity": "noticeable",
      "platforms": [
        "web",
        "universal",
        "unknown"
      ],
      "stacks": [
        "js",
        "web",
        "swift",
        "kotlin",
        "dart",
        "xml"
      ],
      "message": "Social proof or speed claim that the product does not back up.",
      "fix": "Use a real, sourced number with what it compares to, or remove it. Never ship invented customer counts, logo walls, or testimonials.",
      "patterns": [
        "(?:trusted|loved|used) by (?:over |more than )?[\\d,.]+\\s*[kKM]?\\+?\\s*(?:teams|companies|developers|users|customers|people|businesses)",
        "join (?:over |more than )?[\\d,.]+\\s*[kKM]?\\+?\\s+(?:teams|users|developers|customers|people|creators)",
        "\\b\\d+x (?:faster|better|more productive|cheaper)\\b",
        "[\\d.,]+\\s*[bBkKM]?\\+?\\s*(?:ekibin|şirketin|kullanıcının|müşterinin|geliştiricinin|işletmenin) güvendiği",
        "\\b\\d+ kat daha (?:hızlı|iyi|verimli|ucuz)\\b"
      ],
      "ignoreCase": true
    },
    {
      "id": "truth.invented-stat",
      "severity": "minor",
      "platforms": [
        "mobile",
        "web",
        "universal",
        "unknown"
      ],
      "stacks": [
        "js",
        "web",
        "swift",
        "kotlin",
        "dart"
      ],
      "message": "Hard-coded statistic in the interface.",
      "fix": "Compute it from real data, or mark it as placeholder content. Stat tiles with invented numbers mislead users.",
      "patterns": [
        ">\\s*[+↑↓]?\\d{1,3}(?:[.,]\\d{1,3})*\\s*(?:%|[kKM]\\+?|\\+)\\s*<",
        "(?:value|stat|metric|count|total|number)\\s*:\\s*[\"'][+↑↓]?\\d{1,3}(?:[.,]\\d{1,3})*\\s*(?:%|[kKM]\\+?|\\+)[\"']"
      ]
    },
    {
      "id": "truth.placeholder-content",
      "severity": "noticeable",
      "platforms": [
        "mobile",
        "web",
        "universal",
        "unknown"
      ],
      "stacks": [
        "js",
        "web",
        "swift",
        "kotlin",
        "dart",
        "xml"
      ],
      "message": "Placeholder content shipped as if it were real: Lorem ipsum, John Doe, Acme Inc.",
      "fix": "Use the product's real data, or realistic sample data that says it is a sample. A reviewer cannot judge a layout filled with filler.",
      "ignoreCase": true,
      "patterns": [
        "\\blorem ipsum\\b",
        "\\bdolor sit amet\\b",
        "\\b(?:john|jane) doe\\b",
        "\\bacme (?:inc|corp|co|ltd)\\b",
        "\\b123 main st(?:reet)?\\b",
        "\\b(?:ahmet|ayşe|mehmet) yılmaz\\b"
      ]
    }
  ]
}
