{
  "family": "a11y",
  "title": "Accessibility",
  "rules": [
    {
      "id": "a11y.fixed-text-size",
      "severity": "noticeable",
      "platforms": [
        "mobile",
        "web",
        "universal",
        "unknown"
      ],
      "stacks": [
        "swift",
        "js",
        "dart",
        "xml",
        "kotlin"
      ],
      "message": "Text that ignores the user's text size setting.",
      "fix": "Use platform text styles (.body, MaterialTheme.typography, textTheme) or scale custom sizes (relativeTo:, UIFontMetrics, sp). Check at the largest size.",
      "patterns": [
        "\\.system\\(\\s*size:\\s*\\d",
        "\\.custom\\([^)]*size:\\s*\\d",
        "allowFontScaling\\s*[=:]\\s*\\{?\\s*false",
        "maxFontSizeMultiplier\\s*[=:]\\s*\\{?\\s*1(?:\\.0+)?\\b",
        "TextScaler\\.noScaling",
        "android:textSize=\"\\d+(?:\\.\\d+)?(?:dp|px)\""
      ]
    },
    {
      "id": "a11y.focus-removed",
      "severity": "noticeable",
      "platforms": [
        "web",
        "universal",
        "unknown"
      ],
      "stacks": [
        "js",
        "web",
        "css"
      ],
      "message": "Focus outline removed with nothing in its place.",
      "fix": "Keep a visible :focus-visible style in the palette: a 2px outline or ring with an offset.",
      "fileExcludes": [
        "focus-visible",
        "focus:ring",
        "focus-ring",
        "focus-within",
        "focus:bg-",
        "focus:text-",
        "focus:border-"
      ],
      "patterns": [
        "(?:focus:)?outline-none",
        "outline:\\s*(?:none|0)\\b"
      ],
      "excludePatterns": [
        "aria-selected:",
        "bg-popover",
        "data-\\[state=open\\]"
      ]
    },
    {
      "id": "a11y.img-no-alt",
      "severity": "noticeable",
      "platforms": [
        "web",
        "universal",
        "unknown"
      ],
      "stacks": [
        "js",
        "web"
      ],
      "message": "Image without alt text.",
      "fix": "Describe what the image shows, or use alt=\"\" for pure decoration.",
      "patterns": [
        "<img(?![^>]*\\balt=)[^>]*>"
      ]
    },
    {
      "id": "a11y.zoom-disabled",
      "severity": "noticeable",
      "platforms": [
        "web",
        "universal",
        "unknown"
      ],
      "stacks": [
        "js",
        "web"
      ],
      "message": "Pinch zoom disabled in the viewport settings.",
      "fix": "Remove maximum-scale and user-scalable. If inputs zoom on focus in iOS, give them a 16px font size instead.",
      "patterns": [
        "user-scalable\\s*=\\s*(?:no|0)",
        "maximum-scale\\s*=\\s*1(?:\\.0+)?(?!\\d)",
        "userScalable:\\s*false",
        "maximumScale:\\s*1(?:\\.0+)?(?!\\d)"
      ]
    },
    {
      "id": "a11y.low-contrast",
      "severity": "noticeable",
      "platforms": [
        "mobile",
        "web",
        "spatial",
        "universal",
        "unknown"
      ],
      "stacks": [
        "js",
        "web",
        "css"
      ],
      "message": "Text and background in the same rule fail WCAG contrast (4.5:1, or 3:1 for large text).",
      "fix": "Darken the text or the surface until the pair passes, and keep the fix in the theme tokens so every screen gets it. Check the dark theme too.",
      "patterns": [
        {
          "re": "\\{[^{}]{0,1500}\\}",
          "contrast": {
            "min": 4.5,
            "large": 3
          }
        }
      ]
    },
    {
      "id": "a11y.tiny-text",
      "severity": "minor",
      "platforms": [
        "mobile",
        "web",
        "spatial",
        "universal",
        "unknown"
      ],
      "stacks": [
        "js",
        "web",
        "css",
        "kotlin",
        "dart"
      ],
      "message": "Text smaller than 11px.",
      "fix": "Body at 16px (17pt on iOS, 16sp on Android), secondary text no smaller than 12. Under 11 is unreadable for many people and below both platforms' minimum.",
      "patterns": [
        "font-size:\\s*(?:[1-9]|10)(?:\\.\\d+)?px",
        "font-size:\\s*0?\\.(?:[1-5]\\d*|6(?:[0-7]\\d*)?)rem",
        "\\bfontSize\\s*[:=]\\s*\\{?\\s*(?:[1-9]|10)(?:\\.\\d+)?\\b(?!\\.\\d)",
        "\\btext-\\[(?:(?:[1-9]|10)(?:\\.\\d+)?px|0?\\.(?:[1-5]\\d*|6(?:[0-7]\\d*)?)rem)\\]"
      ]
    }
  ]
}
